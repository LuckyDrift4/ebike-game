<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Folder" referent="RBX0"><Properties><string name="Name">RideKit</string></Properties>
<Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- RideKit settings. Tweak these in Studio while play-testing.
-- Distances are in studs, speeds in studs/second, angles in degrees unless noted.
local Config = {
	-- names of the parts RideKit looks for inside the bike model
	WheelPartName = "Wheel", -- the two invisible cylinder wheels
	SteerHingeName = "TripleTreeHinge", -- steering head (fork pivots around this)
	SwingHingeName = "RearSwingArmHinge", -- swingarm pivot
	SeatPartKeyword = "seat", -- part whose name contains this is the seat (else the highest seat-shaped part)
	FallbackRake = 26, -- steering-axis angle if there is no TripleTreeHinge

	-- engine / handling
	MaxSpeed = 70, -- ~70 km/h at Roblox scale
	ReverseSpeed = 10,
	Acceleration = 34,
	BrakeDecel = 70,
	CoastDecel = 5,
	SteerRate = 2.4, -- heading change (rad/s) at full lock
	FullTurnSpeed = 10, -- below this speed steering is weaker (a bike can't turn on the spot)
	MaxSteerAngle = 30, -- visual fork angle at walking pace (less at speed)
	MaxLean = 35, -- lean into corners at speed
	LeanFullSpeed = 30,
	LeanResponse = 6,
	SideGrip = 10, -- how quickly sideways sliding is killed (1/s)

	-- suspension (raycast)
	SuspensionTravel = 0.5,
	SpringRate = 1.0, -- 1.0 = sits at half travel; higher = stiffer
	Damping = 1.0, -- 1.0 = critically damped (no bounce); lower = springier
	AlignResponsiveness = 40,
	ChassisDensity = 0.7,

	-- wheelie (hold E on keyboard / X on gamepad / on-screen button on mobile)
	WheelieKeys = { Enum.KeyCode.E, Enum.KeyCode.ButtonX },
	WheelieAngle = 24,
	WheelieMinSpeed = 6,

	-- rider placement on the seat (R6)
	SeatHeight = "auto", -- "auto" = as low as needed for the feet to reach the pegs, or a number
	-- (HumanoidRootPart height above the seat top, e.g. 1.0)
	SeatForward = "auto", -- "auto" = slide forward until the hands reach the bars, or a number
	GripInset = 0.25, -- hands sit this far in from the ends of the handlebar
	PegInset = 0.15, -- feet sit this far in from the ends of the foot-peg bar

	-- rider pose (radians). Hands are aimed at the grips and feet at the pegs
	-- automatically; these only shape the body around them.
	Pose = {
		TorsoLean = 0.30, -- leaning forward over the bars
		TorsoLeanThrottle = 0.10, -- extra tuck when accelerating
		TorsoLeanSpeed = 0.08, -- extra tuck at top speed
		BrakeLeanBack = 0.12,
		WheelieLeanBack = 0.30,
		MaxExtraLean = 0.45, -- lean up to this much further when the grips are out of reach
		TurnLean = 0.18, -- rider leans further into the corner than the bike
		TurnTwist = 0.15, -- shoulders follow the bars (fine-tuned automatically so both hands reach)
		HeadTurn = 0.30, -- look into the corner
		HeadDown = 0.10, -- slight chin-down when slow
		HeadUp = 0.10, -- look further ahead at speed
		Bounce = 0.04, -- body bob from the suspension
	},}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[-- RideKit.Rig (server): turns a static, anchored bike model into a rideable rig.
--
-- Every BasePart of the model is sorted into one of five groups and welded to
-- that group's root:
--   body        -> RideKit_Chassis   (invisible physics box, carries everything)
--   steer       -> RideKit_SteerPivot (forks, bars, levers; turns about the steering axis)
--   frontSpin   -> RideKit_FrontHub   (front wheel mesh; spins, steers, compresses)
--   swing       -> RideKit_SwingPivot (swingarm, chain, mudguard; pivots with the suspension)
--   rearSpin    -> RideKit_RearHub    (rear wheel mesh; spins)
-- The roots are joined with Motor6Ds whose Transform the client animates.
--
-- Works with plain bike models (surron1: parts named fork/handlebar/swingarm)
-- and chassis-kit style models (surron2: Misc > Wheel = handlebar assembly,
-- FrontSection/RearSection > Wheel with WheelFixed / Parts, Misc > Step = pegs).
-- The decision logic is in pure functions (classify, pickSeat, pickPegs,
-- riderSetup) so it can be tested outside Roblox (see roblox/tests).

local Rig = {}

local STEER_WORDS = { "fork", "handlebar", "hadnlebar", "lever", "grip", "triple", "clamp", "throttle" }
local STEER_MODELS = { forks = true, bars = true, brakes = true, handlebars = true, steering = true }
local SWING_WORDS = { "swingarm", "swing arm", "chain", "mudguard", "hugger" }

local function hasWord(name: string, words: { string }): boolean
	local n = string.lower(name)
	for _, w in ipairs(words) do
		if string.find(n, w, 1, true) then
			return true
		end
	end
	return false
end
Rig.hasWord = hasWord

-- extent of a box along a world direction
local function extentAlong(cf: CFrame, size: Vector3, dir: Vector3): number
	return math.abs(cf.RightVector:Dot(dir)) * size.X
		+ math.abs(cf.UpVector:Dot(dir)) * size.Y
		+ math.abs(cf.LookVector:Dot(dir)) * size.Z
end
Rig.extentAlong = extentAlong

-- the two ends of a bar-shaped part along `right` (left end, right end), pulled in by `inset`
function Rig.lateralEnds(cf: CFrame, size: Vector3, right: Vector3, inset: number, minHalf: number?): (Vector3, Vector3)
	local half = math.max(extentAlong(cf, size, right) / 2 - inset, minHalf or 0)
	return cf.Position - right * half, cf.Position + right * half
end

-- perpendicular distance from point p to the line through a with unit direction d,
-- and the coordinate of p along that line
local function lineDistance(p: Vector3, a: Vector3, d: Vector3): (number, number)
	local v = p - a
	local along = v:Dot(d)
	return (v - d * along).Magnitude, along
end

--[[ Which group a part belongs to.
  info: { name, pos, isFront, isRear, inFront, inRear, ancestors = { {name=, class=}, ... } }
  ctx : { frontPos, rearPos, radF, radR, steerPos, steerAxis, swingPos, fwd }
]]
function Rig.classify(info, ctx): string
	if info.isFront then
		return "frontSpin"
	elseif info.isRear then
		return "rearSpin"
	end
	local pos = info.pos
	if (pos - ctx.frontPos).Magnitude < ctx.radF * 0.3 then
		return "frontSpin" -- tyre / rim / disc: centred on the axle
	elseif (pos - ctx.rearPos).Magnitude < ctx.radR * 0.3 then
		return "rearSpin"
	end
	if info.inFront or hasWord(info.name, STEER_WORDS) then
		return "steer"
	end
	for _, a in ipairs(info.ancestors) do
		local n = string.lower(a.name)
		-- chassis kits keep the handlebar assembly in a Model named "Wheel" (the steering wheel)
		if STEER_MODELS[n] or (n == "wheel" and a.class == "Model") then
			return "steer"
		end
	end
	if info.inRear or (hasWord(info.name, SWING_WORDS) and (pos - ctx.swingPos):Dot(ctx.fwd) < 0.2) then
		return "swing" -- only parts behind the swingarm pivot
	end
	local d, along = lineDistance(pos, ctx.steerPos, ctx.steerAxis)
	if d < 0.4 and along > -0.4 then
		return "steer" -- small bits on the steering column (clamp bolts, stem)
	end
	return "body"
end

--[[ The seat: a part with "seat" in its name, else the highest seat-shaped part
  (long front-to-back, narrow, thin) between the swingarm pivot and the rear axle.
  parts: { {name, cf, size}, ... }; returns the chosen entry or nil ]]
function Rig.pickSeat(parts, keyword: string, ctx)
	for _, p in ipairs(parts) do
		if string.find(string.lower(p.name), keyword, 1, true) then
			return p
		end
	end
	local best, bestTop = nil, -math.huge
	local x0 = (ctx.swingPos - ctx.rearPos):Dot(ctx.fwd) + 0.6 -- a bit ahead of the pivot
	for _, p in ipairs(parts) do
		local x = (p.cf.Position - ctx.rearPos):Dot(ctx.fwd)
		local long = extentAlong(p.cf, p.size, ctx.fwd)
		local wide = extentAlong(p.cf, p.size, ctx.right)
		local tall = extentAlong(p.cf, p.size, ctx.up)
		-- seat-shaped: long front-to-back, not wider than long, thin (not a frame or body shell)
		if x > 0.1 and x < x0 and long > 0.8 and long > wide and tall < 0.9 then
			local top = p.cf.Position:Dot(ctx.up) + extentAlong(p.cf, p.size, ctx.up) / 2
			if top > bestTop then
				best, bestTop = p, top
			end
		end
	end
	return best
end

--[[ Foot pegs: parts named *peg* / *step* (or inside a model with that name).
  One wide part -> its two ends; several parts -> the outermost left and right.
  parts: { {name, parentName, cf, size}, ... }; returns pegL, pegR (or nil) ]]
function Rig.pickPegs(parts, right: Vector3, inset: number)
	local cands = {}
	for _, p in ipairs(parts) do
		local n, pn = string.lower(p.name), string.lower(p.parentName or "")
		if string.find(n, "peg", 1, true) or string.find(n, "step", 1, true)
			or string.find(pn, "peg", 1, true) or string.find(pn, "step", 1, true) then
			table.insert(cands, p)
		end
	end
	if #cands == 0 then
		return nil, nil
	elseif #cands == 1 then
		return Rig.lateralEnds(cands[1].cf, cands[1].size, right, inset, 0.55)
	end
	local lo, hi = cands[1], cands[1]
	for _, p in ipairs(cands) do
		if p.cf.Position:Dot(right) < lo.cf.Position:Dot(right) then
			lo = p
		end
		if p.cf.Position:Dot(right) > hi.cf.Position:Dot(right) then
			hi = p
		end
	end
	return lo.cf.Position, hi.cf.Position
end

--[[ Where the rider goes (R6).
  d: { seat = {cf,size}|nil, bar = {cf,size}|nil, gripsGuess, pegL, pegR, fwd, right, up, center, radR, wheelbase }
  returns { gripL, gripR, pegL, pegR, seatPos, riderOffset } where riderOffset is the
  HumanoidRootPart position in the seat's frame (seat CFrame = lookAt(seatPos, seatPos + fwd)) ]]
function Rig.riderSetup(d, cfg)
	local fwd, right, up = d.fwd, d.right, d.up
	-- grips
	local gripL, gripR
	if d.bar then
		gripL, gripR = Rig.lateralEnds(d.bar.cf, d.bar.size, right, cfg.GripInset, 0.6)
	else
		gripL, gripR = d.gripsGuess[1], d.gripsGuess[2]
	end
	-- seat
	local seatPos, seatTop, seatHalfLen
	if d.seat then
		local c = d.seat.cf.Position
		local halfH = extentAlong(d.seat.cf, d.seat.size, up) / 2
		seatTop = c:Dot(up) + halfH
		seatPos = c + up * (halfH + 0.1)
		seatHalfLen = extentAlong(d.seat.cf, d.seat.size, fwd) / 2
	else
		seatPos = d.center + up * (d.radR * 1.6) - fwd * d.wheelbase * 0.1
		seatTop = seatPos:Dot(up) - 0.1
		seatHalfLen = 0.8
	end
	-- height: R6 hips 1 stud below the HumanoidRootPart, legs 2 studs
	local pegY = (d.pegL:Dot(up) + d.pegR:Dot(up)) / 2
	local hipY
	if type(cfg.SeatHeight) == "number" then
		hipY = seatTop + cfg.SeatHeight - 1
	else
		hipY = math.clamp(pegY + 2 * 0.96, seatTop - 0.25, seatTop + 0.15)
	end
	local riderUp = hipY + 1 - seatPos:Dot(up)
	-- fore-aft: slide forward along the seat until the hands can reach the grips
	local forward = cfg.SeatForward
	if type(forward) ~= "number" then
		local lean = cfg.Pose.TorsoLean + 0.15
		local reach = math.sqrt(0.5 * 0.5 + 1.5 * 1.5) * 0.97 -- R6 shoulder joint -> hand
		local maxF = math.max(seatHalfLen - 0.15, 0)
		forward = maxF
		for f = 0, maxF + 1e-6, 0.05 do
			local hrp = seatPos + up * riderUp + fwd * f
			local shoulder = hrp + up * (0.5 * math.cos(lean)) + fwd * (0.5 * math.sin(lean))
			local farGrip = math.max(
				(gripL - (shoulder - right * 1)).Magnitude,
				(gripR - (shoulder + right * 1)).Magnitude
			)
			if farGrip <= reach then
				forward = f
				break
			end
		end
	end
	return {
		gripL = gripL,
		gripR = gripR,
		pegL = d.pegL,
		pegR = d.pegR,
		seatPos = seatPos,
		riderOffset = Vector3.new(0, riderUp, -forward),
		forward = forward,
	}
end

-- -------------------------------------------------------------------------------
-- Instance helpers (Roblox only)
-- -------------------------------------------------------------------------------
local function helper(name: string, cf: CFrame, parent: Instance): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = cf
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.Parent = parent
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = part0.CFrame:ToObjectSpace(part1.CFrame)
	m.C1 = CFrame.new()
	m.Parent = part0
	return m
end

local function weld(root: BasePart, part: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Name = "RideKit_Weld"
	w.Part0 = root
	w.Part1 = part
	w.Parent = part
end

local function ancestorsOf(part: Instance, root: Instance)
	local out = {}
	local p = part.Parent
	while p and p ~= root do
		table.insert(out, { name = p.Name, class = p.ClassName })
		p = p.Parent
	end
	return out
end

function Rig.build(bike: Model, cfg)
	if bike:GetAttribute("RideKitReady") then
		return
	end

	-- 1. find the wheels and pivots ------------------------------------------------
	local wheels = {}
	for _, d in ipairs(bike:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == cfg.WheelPartName then
			table.insert(wheels, d)
		end
	end
	assert(#wheels == 2, `RideKit: expected 2 parts named "{cfg.WheelPartName}" in {bike:GetFullName()}, found {#wheels}`)

	local steerHinge = bike:FindFirstChild(cfg.SteerHingeName, true) :: BasePart?
	local swingHinge = bike:FindFirstChild(cfg.SwingHingeName, true) :: BasePart?

	local front, rear = wheels[1], wheels[2]
	if steerHinge then
		if (wheels[2].Position - steerHinge.Position).Magnitude < (wheels[1].Position - steerHinge.Position).Magnitude then
			front, rear = wheels[2], wheels[1]
		end
	else
		-- the wheel nearer to anything called fork/handlebar is the front
		local best = math.huge
		for _, d in ipairs(bike:GetDescendants()) do
			if d:IsA("BasePart") and hasWord(d.Name, { "fork", "handlebar" }) then
				for i, w in ipairs(wheels) do
					local dist = (w.Position - d.Position).Magnitude
					if dist < best then
						best = dist
						front, rear = w, wheels[3 - i]
					end
				end
			end
		end
	end

	local up = Vector3.yAxis
	local flat = front.Position - rear.Position
	local fwd = Vector3.new(flat.X, 0, flat.Z).Unit
	local right = fwd:Cross(up)
	local radF = math.max(front.Size.Y, front.Size.Z) / 2
	local radR = math.max(rear.Size.Y, rear.Size.Z) / 2
	local wheelbase = Vector3.new(flat.X, 0, flat.Z).Magnitude

	local steerPos, steerAxis
	if steerHinge then
		steerPos = steerHinge.Position
		local a = steerHinge.Position - front.Position
		a -= right * a:Dot(right)
		steerAxis = a.Unit
	else
		local rake = math.rad(cfg.FallbackRake)
		steerAxis = (up * math.cos(rake) - fwd * math.sin(rake)).Unit
		steerPos = front.Position + steerAxis * radF * 1.6
	end
	local swingPos = if swingHinge then swingHinge.Position else rear.Position + fwd * wheelbase * 0.38

	-- 2. clear old joints, build roots ---------------------------------------------
	for _, d in ipairs(bike:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end

	local center = (front.Position + rear.Position) / 2 + up * (radR * 0.7)
	local chassis = Instance.new("Part")
	chassis.Name = "RideKit_Chassis"
	chassis.Size = Vector3.new(1.1, 1.1, wheelbase * 0.75)
	chassis.CFrame = CFrame.lookAt(center, center + fwd)
	chassis.Transparency = 1
	chassis.CanCollide = true
	chassis.CanQuery = false
	chassis.CustomPhysicalProperties = PhysicalProperties.new(cfg.ChassisDensity, 0, 0, 1, 1)
	chassis.Anchored = true
	chassis.Parent = bike

	local att = Instance.new("Attachment")
	att.Name = "RideKit_Att"
	att.Parent = chassis
	local align = Instance.new("AlignOrientation")
	align.Name = "RideKit_Align"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.Responsiveness = cfg.AlignResponsiveness
	align.MaxTorque = math.huge
	align.CFrame = chassis.CFrame.Rotation
	align.Parent = chassis

	local steerPivot = helper("RideKit_SteerPivot", CFrame.fromMatrix(steerPos, right, steerAxis), bike)
	local frontHub = helper("RideKit_FrontHub", CFrame.fromMatrix(front.Position, right, up), bike)
	local swingPivot = helper("RideKit_SwingPivot", CFrame.fromMatrix(swingPos, right, up), bike)
	local rearHub = helper("RideKit_RearHub", CFrame.fromMatrix(rear.Position, right, up), bike)
	motor("RideKit_SteerMotor", chassis, steerPivot)
	motor("RideKit_FrontHubMotor", steerPivot, frontHub)
	motor("RideKit_SwingMotor", chassis, swingPivot)
	motor("RideKit_RearHubMotor", swingPivot, rearHub)

	-- 3. sort every part into a group --------------------------------------------
	local ours = {
		[chassis] = true,
		[steerPivot] = true,
		[frontHub] = true,
		[swingPivot] = true,
		[rearHub] = true,
	}
	local ctx = {
		frontPos = front.Position,
		rearPos = rear.Position,
		radF = radF,
		radR = radR,
		steerPos = steerPos,
		steerAxis = steerAxis,
		swingPos = swingPos,
		fwd = fwd,
		right = right,
		up = up,
	}
	local roots = { body = chassis, steer = steerPivot, frontSpin = frontHub, swing = swingPivot, rearSpin = rearHub }
	local counts = { body = 0, steer = 0, frontSpin = 0, swing = 0, rearSpin = 0 }
	local bar: BasePart? = nil -- widest steering part = handlebar
	local barWidth = 0
	local bodyParts = {}
	for _, part in ipairs(bike:GetDescendants()) do
		if not part:IsA("BasePart") or ours[part] then
			continue
		end
		local group = Rig.classify({
			name = part.Name,
			pos = part.Position,
			isFront = part == front,
			isRear = part == rear,
			inFront = part:IsDescendantOf(front),
			inRear = part:IsDescendantOf(rear),
			ancestors = ancestorsOf(part, bike),
		}, ctx)
		if group == "steer" then
			local w = extentAlong(part.CFrame, part.Size, right)
			if w > barWidth then
				bar, barWidth = part, w
			end
		elseif group == "body" then
			table.insert(bodyParts, {
				name = part.Name,
				parentName = if part.Parent then part.Parent.Name else "",
				cf = part.CFrame,
				size = part.Size,
				part = part,
			})
		end
		weld(roots[group], part)
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.Massless = true
		counts[group] += 1
	end

	-- 4. seat, pegs, grips, rider position --------------------------------------------
	local seatRef = Rig.pickSeat(bodyParts, cfg.SeatPartKeyword, ctx)
	local pegL, pegR = Rig.pickPegs(bodyParts, right, cfg.PegInset)
	if not pegL then
		local c = swingPos + fwd * 0.35 + up * 0.05
		pegL, pegR = c - right * 0.6, c + right * 0.6
	end
	local gc = steerPos + steerAxis * 0.9 - fwd * 0.3
	local rider = Rig.riderSetup({
		seat = seatRef,
		bar = if bar then { cf = bar.CFrame, size = bar.Size } else nil,
		gripsGuess = { gc - right * 1.1, gc + right * 1.1 },
		pegL = pegL,
		pegR = pegR,
		fwd = fwd,
		right = right,
		up = up,
		center = center,
		radR = radR,
		wheelbase = wheelbase,
	}, cfg)

	local seat = Instance.new("VehicleSeat")
	seat.Name = "RideKit_Seat"
	seat.Size = Vector3.new(1, 0.2, 1.2)
	seat.CFrame = CFrame.lookAt(rider.seatPos, rider.seatPos + fwd)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Massless = true
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.HeadsUpDisplay = false
	seat.Anchored = false
	seat.Parent = bike
	weld(chassis, seat)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RideKit_Prompt"
	prompt.ActionText = "Ride"
	prompt.ObjectText = bike.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat

	-- 5. data for the client ---------------------------------------------------------
	bike.PrimaryPart = chassis
	bike:SetAttribute("RK_FrontAxle", chassis.CFrame:PointToObjectSpace(front.Position))
	bike:SetAttribute("RK_RearAxle", chassis.CFrame:PointToObjectSpace(rear.Position))
	bike:SetAttribute("RK_RadiusF", radF)
	bike:SetAttribute("RK_RadiusR", radR)
	bike:SetAttribute("RK_SwingArm", math.max((rear.Position - swingPos).Magnitude, 0.5))
	bike:SetAttribute("RK_GripL", steerPivot.CFrame:PointToObjectSpace(rider.gripL))
	bike:SetAttribute("RK_GripR", steerPivot.CFrame:PointToObjectSpace(rider.gripR))
	bike:SetAttribute("RK_PegL", chassis.CFrame:PointToObjectSpace(rider.pegL))
	bike:SetAttribute("RK_PegR", chassis.CFrame:PointToObjectSpace(rider.pegR))
	bike:SetAttribute("RK_RiderOffset", rider.riderOffset)
	bike:AddTag("RideKitBike")
	bike:SetAttribute("RideKitReady", true)

	print(
		`RideKit: {bike.Name} rigged. body {counts.body}, steering {counts.steer}, front wheel {counts.frontSpin}, `
			.. `swingarm {counts.swing}, rear wheel {counts.rearSpin} parts. `
			.. `Grips from "{if bar then bar.Name else "(guessed)"}", seat "{if seatRef then seatRef.name else "(guessed)"}", `
			.. `rider {string.format("%.2f", rider.forward)} forward`
	)
	return { chassis = chassis, seat = seat, prompt = prompt, align = align }
end

return Rig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Physics</string><ProtectedString name="Source"><![CDATA[-- RideKit.Physics: raycast-suspension bike. Runs on whoever owns the bike's
-- physics: the rider's client while riding, the server while it coasts to a stop.

local Physics = {}
Physics.__index = Physics

function Physics.new(bike: Model, cfg)
	local self = setmetatable({}, Physics)
	self.bike = bike
	self.cfg = cfg
	self.chassis = bike:WaitForChild("RideKit_Chassis") :: BasePart
	self.align = self.chassis:WaitForChild("RideKit_Align") :: AlignOrientation
	self.wheels = {
		{ localPos = bike:GetAttribute("RK_FrontAxle"), radius = bike:GetAttribute("RK_RadiusF") },
		{ localPos = bike:GetAttribute("RK_RearAxle"), radius = bike:GetAttribute("RK_RadiusR") },
	}
	self.comp = { cfg.SuspensionTravel * 0.5, cfg.SuspensionTravel * 0.5 }
	self.params = RaycastParams.new()
	self.params.FilterType = Enum.RaycastFilterType.Exclude
	self.params.FilterDescendantsInstances = { bike }
	self.params.IgnoreWater = false
	self:resetHeading()
	return self
end

-- re-read heading from the chassis (call when taking over the physics)
function Physics:resetHeading()
	local look = self.chassis.CFrame.LookVector
	self.yaw = math.atan2(-look.X, -look.Z)
	self.pitch = 0
	self.roll = 0
	self.wheelie = 0
end

function Physics:setIgnore(list: { Instance })
	self.params.FilterDescendantsInstances = list
end

-- suspension compression for wheel i (0 = fully extended) and the ground hit
function Physics:probe(i: number): (number, RaycastResult?)
	local cfg = self.cfg
	local w = self.wheels[i]
	local cf = self.chassis.CFrame
	local upv = cf.UpVector
	local travel = cfg.SuspensionTravel
	local mount = cf:PointToWorldSpace(w.localPos) + upv * (travel * 0.5)
	local hit = workspace:Raycast(mount, -upv * (travel + w.radius + 0.6), self.params)
	if hit then
		local dist = (hit.Position - mount).Magnitude
		return math.clamp(travel + w.radius - dist, 0, travel * 1.6), hit
	end
	return 0, nil
end

-- one physics step. throttle/steer are -1..1; returns forward speed
function Physics:step(dt: number, throttle: number, steer: number, wheelieHeld: boolean, hasDriver: boolean): number
	local cfg = self.cfg
	local ch = self.chassis
	dt = math.clamp(dt, 1 / 240, 1 / 20)
	local mass = ch.AssemblyMass
	local g = workspace.Gravity
	local upv = ch.CFrame.UpVector
	local travel = cfg.SuspensionTravel
	local k = cfg.SpringRate * g / travel -- per wheel; two wheels hold the bike at half travel
	local cd = cfg.Damping * math.sqrt(2 * k)

	-- suspension: implicit (backward-Euler) spring + damper along the bike's up axis.
	-- A plain per-frame spring force lags the 240 Hz physics by a frame, which eats
	-- the damping and makes the bike bounce; solving it implicitly is stable at any
	-- frame rate and settles at ride height.
	local hits = {}
	local grounded = false
	local n, C, rateSum, rateN = 0, 0, 0, 0
	for i = 1, 2 do
		local comp, hit = self:probe(i)
		if hit and comp > 0 then
			hits[i] = hit
			grounded = true
			n += 1
			C += comp + 3 * math.max(comp - travel, 0) -- stiff bump stop past full travel
			if self.comp[i] > 0 then
				rateSum += (comp - self.comp[i]) / dt
				rateN += 1
			end
			self.comp[i] = comp
		else
			self.comp[i] = 0
		end
	end
	if n > 0 then
		local gUp = g * math.max(upv.Y, 0.2)
		-- chassis speed along up, measured from how fast the springs extend
		local vUp = if rateN > 0 then -rateSum / rateN else ch.AssemblyLinearVelocity:Dot(upv)
		local vNew = (vUp + dt * (k * C - gUp)) / (1 + n * k * dt * dt + n * cd * dt)
		local dv = math.clamp(vNew - vUp + gUp * dt, -g * dt * 2, g * dt * 8)
		ch:ApplyImpulse(upv * dv * mass)
	end

	-- drive, brake and tyre grip in the heading frame
	local fwd = Vector3.new(-math.sin(self.yaw), 0, -math.cos(self.yaw))
	local right = Vector3.new(math.cos(self.yaw), 0, -math.sin(self.yaw))
	local v = ch.AssemblyLinearVelocity
	local vF = v:Dot(fwd)
	local vS = v:Dot(right)
	if grounded then
		local target, rate
		if throttle > 0.05 then
			target = throttle * cfg.MaxSpeed
			rate = if vF < -0.5 then cfg.BrakeDecel else cfg.Acceleration
		elseif throttle < -0.05 then
			if vF > 0.5 then
				target, rate = 0, cfg.BrakeDecel
			else
				target, rate = throttle * cfg.ReverseSpeed, cfg.Acceleration * 0.5
			end
		else
			target = 0
			rate = if hasDriver then cfg.CoastDecel else cfg.BrakeDecel
		end
		local dv = math.clamp(target - vF, -rate * dt, rate * dt)
		local side = -vS * (1 - math.exp(-cfg.SideGrip * dt))
		ch:ApplyImpulse((fwd * dv + right * side) * mass)

		-- steering turns the heading; weak at walking pace, gentler at top speed
		local speed = math.abs(vF)
		local turn = math.clamp(speed / cfg.FullTurnSpeed, 0, 1) * (1 - 0.45 * math.clamp(speed / cfg.MaxSpeed, 0, 1))
		local dir = if vF >= 0 then 1 else -1
		self.yaw -= steer * cfg.SteerRate * turn * dir * dt
	end

	-- lean into corners (positive roll = lean left)
	local leanAmt = math.clamp(math.abs(vF) / cfg.LeanFullSpeed, 0, 1)
	local targetRoll = if grounded then -steer * math.rad(cfg.MaxLean) * leanAmt else self.roll
	self.roll += (targetRoll - self.roll) * (1 - math.exp(-cfg.LeanResponse * dt))

	-- pitch follows the ground under both wheels, plus the wheelie
	local targetPitch = self.pitch
	if hits[1] and hits[2] then
		local d = hits[1].Position - hits[2].Position
		if d.Magnitude > 0.1 then
			targetPitch = math.asin(math.clamp(d.Y / d.Magnitude, -1, 1))
		end
	elseif not grounded then
		targetPitch = self.pitch * (1 - dt * 0.4)
	end
	self.pitch += (targetPitch - self.pitch) * (1 - math.exp(-10 * dt))
	local wantWheelie = wheelieHeld and hits[2] ~= nil and vF > cfg.WheelieMinSpeed and throttle > 0.3
	local wTarget = if wantWheelie then math.rad(cfg.WheelieAngle) else 0
	self.wheelie += (wTarget - self.wheelie) * (1 - math.exp(-(if wantWheelie then 2.5 else 4) * dt))

	self.align.CFrame = CFrame.fromEulerAnglesYXZ(self.pitch + self.wheelie, self.yaw, self.roll)
	return vF
end

return Physics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Pose</string><ProtectedString name="Source"><![CDATA[-- RideKit.Pose: procedural R6 riding pose. Every client poses every rider, so it
-- needs no uploaded animation and looks the same for everyone.
--
-- Instead of guessing joint angles, each limb is AIMED at a real point on the
-- bike: hands at the handlebar grips (which follow the steering), feet at the
-- foot pegs, head looking down the road. Joint transforms are then solved from
--   Part1.CFrame = Part0.CFrame * C0 * Transform * C1:Inverse()
-- using the joints' own C0/C1, so the result is right for any standard R6 rig.
--
-- The R6 "Animate" script poses seated characters by spinning the shoulder and
-- hip Motors (DesiredAngle / CurrentAngle), which would add on top of this, so
-- those angles are zeroed every frame (and the local rider's Animate script is
-- paused by the client while riding).

local Pose = {}

local JOINTS = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	RS = { "Torso", "Right Shoulder" },
	LS = { "Torso", "Left Shoulder" },
	RH = { "Torso", "Right Hip" },
	LH = { "Torso", "Left Hip" },
}
local KEYS = { "Root", "Neck", "RS", "LS", "RH", "LH" }

-- returns the R6 joints + limb sizes, or nil for R15 / incomplete characters
function Pose.joints(character: Model)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R6 then
		return nil
	end
	local j = {}
	for key, path in pairs(JOINTS) do
		local part = character:FindFirstChild(path[1])
		local m = part and part:FindFirstChild(path[2])
		if not (m and m:IsA("Motor6D")) then
			return nil
		end
		j[key] = m
	end
	j.hrp = character:FindFirstChild("HumanoidRootPart")
	local arm = character:FindFirstChild("Right Arm")
	local leg = character:FindFirstChild("Right Leg")
	j.armLen = if arm and arm:IsA("BasePart") then arm.Size.Y else 2
	j.legLen = if leg and leg:IsA("BasePart") then leg.Size.Y else 2
	return j
end

-- limb-space vector from the joint (C1 position) to the hand / foot
local function tipOf(m, len: number): Vector3
	return Vector3.new(0, -len / 2, 0) - m.C1.Position
end

-- rotation that points a limb from world point `joint` at `target`, keeping the
-- limb's X axis close to `rightHint` (no corkscrew twist)
local function aimLimb(joint: Vector3, target: Vector3, tip: Vector3, rightHint: Vector3): CFrame
	local d = target - joint
	local R = CFrame.new()
	for _ = 1, 3 do
		if d.Magnitude < 1e-4 then
			break
		end
		local y = -d.Unit -- limb +Y runs from the hand back up to the joint
		local x = rightHint - y * rightHint:Dot(y)
		if x.Magnitude < 1e-3 then
			x = y:Cross(Vector3.zAxis)
		end
		R = CFrame.fromMatrix(Vector3.zero, x.Unit, y)
		-- the hand sits off the limb axis (tip.X / tip.Z): aim the axis so the hand lands on target
		local side = R:VectorToWorldSpace(Vector3.new(tip.X, 0, tip.Z))
		d = target - side - joint
	end
	return R
end

-- Transform that gives Part1 the world rotation `childRot` under Part0 at `parentCF`
local function solve(m, parentCF: CFrame, childRot: CFrame): CFrame
	return m.C0.Rotation:Inverse() * parentCF.Rotation:Inverse() * childRot * m.C1.Rotation
end

--[[
  j       : from Pose.joints (motors + hrp + limb sizes)
  hrpCF   : HumanoidRootPart CFrame (welded to the seat)
  bikeCF  : bike chassis CFrame (head looks along it)
  targets : { gripL, gripR, pegL, pegR } world positions
  p       : Config.Pose
  s       : { throttle, steer, speed, maxSpeed, wheelie, bounce, dt }
  returns : torso CFrame, hand and foot positions (for debugging/tests)
]]
function Pose.solve(j, hrpCF: CFrame, bikeCF: CFrame, targets, p, s)
	for _, key in ipairs(KEYS) do
		local m = j[key]
		m.MaxVelocity = 0
		m.DesiredAngle = 0
		m.CurrentAngle = 0
	end

	local speedFrac = math.clamp(math.abs(s.speed) / s.maxSpeed, 0, 1)
	local turn = s.steer * math.clamp(math.abs(s.speed) / 15, 0.3, 1)
	local lean = p.TorsoLean
		+ p.TorsoLeanThrottle * math.max(s.throttle, 0)
		+ p.TorsoLeanSpeed * speedFrac
		- p.BrakeLeanBack * math.max(-s.throttle, 0) * (if s.speed > 1 then 1 else 0)
		- p.WheelieLeanBack * math.clamp(s.wheelie / 0.4, 0, 1)
		+ p.Bounce * s.bounce

	-- torso (rotates about its centre, the HRP). R6 arms can't bend, so search a
	-- small range of extra lean and shoulder twist for the stance where both hands
	-- land on the grips (and the feet still reach the pegs).
	local armTip = tipOf(j.RS, j.armLen)
	local legTip = tipOf(j.RH, j.legLen)
	local armReach, legReach = armTip.Magnitude, legTip.Magnitude
	local root = j.Root
	local roll = CFrame.fromAxisAngle(Vector3.zAxis, -p.TurnLean * turn)
	local baseTwist = -p.TurnTwist * s.steer
	local function torsoFor(extra: number, tw: number): (CFrame, CFrame)
		local local_ = CFrame.fromAxisAngle(Vector3.yAxis, baseTwist + tw) * roll
			* CFrame.fromAxisAngle(Vector3.xAxis, -(lean + extra))
		local T = solve(root, hrpCF, hrpCF.Rotation * local_)
		return T, hrpCF * root.C0 * T * root.C1:Inverse()
	end
	local best, bestExtra, bestTw = math.huge, 0, 0
	for extra = -0.15, p.MaxExtraLean + 1e-6, 0.05 do
		for tw = -0.6, 0.6 + 1e-6, 0.05 do
			local _, torso = torsoFor(extra, tw)
			local dR = (targets.gripR - torso * j.RS.C0.Position).Magnitude - armReach
			local dL = (targets.gripL - torso * j.LS.C0.Position).Magnitude - armReach
			local fR = math.max((targets.pegR - torso * j.RH.C0.Position).Magnitude - legReach, 0)
			local fL = math.max((targets.pegL - torso * j.LH.C0.Position).Magnitude - legReach, 0)
			local cost = dR * dR + dL * dL + 0.5 * (fR * fR + fL * fL) + 0.02 * extra * extra + 0.01 * tw * tw
			if cost < best then
				best, bestExtra, bestTw = cost, extra, tw
			end
		end
	end
	-- glide towards the best stance instead of snapping (the search is coarse)
	local mem = j.mem or { extra = bestExtra, tw = bestTw }
	j.mem = mem
	local a = if s.dt then 1 - math.exp(-12 * s.dt) else 1
	mem.extra += (bestExtra - mem.extra) * a
	mem.tw += (bestTw - mem.tw) * a
	local rootT, torsoCF = torsoFor(mem.extra, mem.tw)
	root.Transform = rootT

	-- head: eyes level with the horizon (follows the bike's lean, not its pitch),
	-- looking into the corner a little
	local look = bikeCF.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = if flatLook.Magnitude > 1e-3 then flatLook.Unit else hrpCF.LookVector
	local headUp = (Vector3.yAxis + bikeCF.UpVector).Unit
	local headRight = flatLook:Cross(headUp).Unit
	local headRot = CFrame.fromMatrix(Vector3.zero, headRight, headRight:Cross(flatLook))
		* CFrame.fromAxisAngle(Vector3.yAxis, -p.HeadTurn * s.steer)
		* CFrame.fromAxisAngle(Vector3.xAxis, -p.HeadDown + p.HeadUp * speedFrac)
	j.Neck.Transform = solve(j.Neck, torsoCF, headRot)

	-- arms to the grips, legs to the pegs
	local right = torsoCF.RightVector
	local out = { torso = torsoCF }
	local limbs = {
		{ j.RS, targets.gripR, j.armLen, "handR" },
		{ j.LS, targets.gripL, j.armLen, "handL" },
		{ j.RH, targets.pegR, j.legLen, "footR" },
		{ j.LH, targets.pegL, j.legLen, "footL" },
	}
	for _, l in ipairs(limbs) do
		local m, target, len, name = l[1], l[2], l[3], l[4]
		local jointW = torsoCF * m.C0.Position
		local tip = tipOf(m, len)
		local R = aimLimb(jointW, target, tip, right)
		m.Transform = solve(m, torsoCF, R)
		out[name] = jointW + R:VectorToWorldSpace(tip)
	end
	return out
end

-- local rider only: stop the default animations and pause the Animate script
function Pose.takeOver(character: Model)
	local animate = character:FindFirstChild("Animate")
	if animate and (animate:IsA("LocalScript") or animate:IsA("Script")) then
		animate.Disabled = true
	end
	Pose.silence(character)
end

function Pose.release(character: Model)
	local animate = character:FindFirstChild("Animate")
	if animate and (animate:IsA("LocalScript") or animate:IsA("Script")) then
		animate.Disabled = false
	end
end

function Pose.clear(j)
	for _, key in ipairs(KEYS) do
		j[key].Transform = CFrame.new()
	end
end

-- stop the default sit / idle animation tracks on a rider (local view only)
function Pose.silence(character: Model)
	local hum = character:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
	end
end

return Pose
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX5"><Properties><string name="Name">BikeServer</string><ProtectedString name="Source"><![CDATA[-- RideKit.BikeServer (Script, RunContext = Server). Lives in the RideKit folder
-- inside the bike model. Rigs the bike, handles mounting and network ownership,
-- and lets the bike roll to a stop after the rider gets off.

local kit = script.Parent
local bike = kit.Parent :: Model
local Config = require(kit:WaitForChild("Config"))
local Rig = require(kit:WaitForChild("Rig"))
local Physics = require(kit:WaitForChild("Physics"))

-- @body (everything below is shared with the single-file RideKit_Server.lua)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local rig = Rig.build(bike, Config)
local seat: VehicleSeat = rig.seat
local chassis: BasePart = rig.chassis
local prompt: ProximityPrompt = rig.prompt
local physics = Physics.new(bike, Config)

-- mount with the prompt (walking into the seat works too)
prompt.Triggered:Connect(function(player)
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and seat.Occupant == nil then
		seat:Sit(hum)
	end
end)

-- place the rider on the seat: low enough for the feet to reach the pegs
seat.ChildAdded:Connect(function(child)
	if child.Name == "SeatWeld" and child:IsA("Weld") then
		task.defer(function()
			child.C0 = CFrame.new(bike:GetAttribute("RK_RiderOffset"))
			child.C1 = CFrame.new()
		end)
	end
end)

local coasting = false
seat:GetPropertyChangedSignal("Occupant"):Connect(function()
	local occupant = seat.Occupant
	prompt.Enabled = occupant == nil
	if occupant then
		coasting = false
		local player = Players:GetPlayerFromCharacter(occupant.Parent)
		chassis.Anchored = false
		if player then
			chassis:SetNetworkOwner(player)
		end
	else
		if not chassis.Anchored then
			chassis:SetNetworkOwner(nil)
			physics:resetHeading()
			coasting = true
		end
	end
end)

-- after dismounting: brake to a stop on the server, then park (anchor) upright
local stillTime = 0
RunService.Stepped:Connect(function(_, dt)
	if not coasting then
		return
	end
	local speed = physics:step(dt, 0, 0, false, false)
	if math.abs(speed) < 0.5 then
		stillTime += dt
	else
		stillTime = 0
	end
	if stillTime > 0.75 then
		coasting = false
		stillTime = 0
		chassis.Anchored = true
		chassis.AssemblyLinearVelocity = Vector3.zero
		chassis.AssemblyAngularVelocity = Vector3.zero
	end
end)
]]></ProtectedString><token name="RunContext">1</token><bool name="Disabled">false</bool></Properties></Item>
<Item class="Script" referent="RBX6"><Properties><string name="Name">BikeClient</string><ProtectedString name="Source"><![CDATA[-- RideKit.BikeClient (Script, RunContext = Client). Runs on every player's
-- machine for this bike:
--   * drives the bike when the local player is the rider
--   * animates wheels, fork, suspension for everyone
--   * poses the rider (R6) for everyone

local kit = script.Parent
local Config = require(kit:WaitForChild("Config"))
local Physics = require(kit:WaitForChild("Physics"))
local Pose = require(kit:WaitForChild("Pose"))

-- @body (everything below is shared with the single-file RideKit_Client.lua)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local function runBike(bike: Model)
	if not bike:GetAttribute("RideKitReady") then
		bike:GetAttributeChangedSignal("RideKitReady"):Wait()
	end

	local player = Players.LocalPlayer
	local chassis = bike:WaitForChild("RideKit_Chassis") :: BasePart
	local seat = bike:WaitForChild("RideKit_Seat") :: VehicleSeat
	local steerPivot = bike:WaitForChild("RideKit_SteerPivot") :: BasePart
	local swingPivot = bike:WaitForChild("RideKit_SwingPivot") :: BasePart
	local steerMotor = chassis:WaitForChild("RideKit_SteerMotor") :: Motor6D
	local swingMotor = chassis:WaitForChild("RideKit_SwingMotor") :: Motor6D
	local frontHubMotor = steerPivot:WaitForChild("RideKit_FrontHubMotor") :: Motor6D
	local rearHubMotor = swingPivot:WaitForChild("RideKit_RearHubMotor") :: Motor6D

	local physics = Physics.new(bike, Config)
	local radF = bike:GetAttribute("RK_RadiusF") :: number
	local radR = bike:GetAttribute("RK_RadiusR") :: number
	local armLen = bike:GetAttribute("RK_SwingArm") :: number
	local travel = Config.SuspensionTravel
	local gripL = bike:GetAttribute("RK_GripL") :: Vector3
	local gripR = bike:GetAttribute("RK_GripR") :: Vector3
	local pegL = bike:GetAttribute("RK_PegL") :: Vector3
	local pegR = bike:GetAttribute("RK_PegR") :: Vector3

	-- wheelie input (keyboard / gamepad / mobile button while riding)
	local wheelieHeld = false
	local ACTION = "RideKitWheelie_" .. bike.Name .. "_" .. tostring(math.random(1, 1e9))
	local function onWheelie(_, state)
		wheelieHeld = state == Enum.UserInputState.Begin
		return Enum.ContextActionResult.Sink
	end

	local wasDriver = false
	local spinF, spinR, steerVis = 0, 0, 0
	local riderJoints, riderChar = nil, nil
	local tookOver = false
	local poseBounce = 0

	-- motor / wind sounds and brake lights already in the model (played locally)
	local engineSound, windSound = nil, nil
	for _, d in ipairs(bike:GetDescendants()) do
		if d:IsA("Sound") then
			if string.lower(d.Name) == "wind" then
				windSound = d
			elseif d.Looped and not engineSound then
				engineSound = d
			end
		end
	end
	local engineVol = if engineSound then engineSound.Volume else 0
	local windVol = if windSound then windSound.Volume else 0
	local brakeLights = {}
	for _, d in ipairs(bike:GetDescendants()) do
		if d:IsA("Light") then
			local a = d.Parent
			while a and a ~= bike do
				local n = string.lower(a.Name)
				if n == "brk" or string.find(n, "brakelight", 1, true) or string.find(n, "brake light", 1, true) then
					table.insert(brakeLights, d)
					break
				end
				a = a.Parent
			end
		end
	end
	local offF, offR = 0, 0

	local conn
	conn = RunService.Stepped:Connect(function(_, dt)
		if not bike:IsDescendantOf(workspace) then
			conn:Disconnect()
			return
		end
		local occupant = seat.Occupant
		local char = occupant and occupant.Parent
		local isDriver = char ~= nil and char == player.Character

		-- input binding follows the driver role
		if isDriver ~= wasDriver then
			wasDriver = isDriver
			if isDriver then
				physics:resetHeading()
				ContextActionService:BindAction(ACTION, onWheelie, true, table.unpack(Config.WheelieKeys))
				ContextActionService:SetTitle(ACTION, "Wheelie")
			else
				ContextActionService:UnbindAction(ACTION)
				wheelieHeld = false
			end
		end

		physics:setIgnore(if char then { bike, char } else { bike })
		local throttle = if char then seat.ThrottleFloat else 0
		local steer = if char then seat.SteerFloat else 0

		if isDriver and not chassis.Anchored then
			physics:step(dt, throttle, steer, wheelieHeld, true)
		end

		-- visuals for everyone: spin, steer, suspension
		local vF = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)
		spinF = (spinF + vF / radF * dt) % (2 * math.pi)
		spinR = (spinR + vF / radR * dt) % (2 * math.pi)
		local speedFrac = math.clamp(math.abs(vF) / Config.MaxSpeed, 0, 1)
		local steerTarget = steer * math.rad(Config.MaxSteerAngle) * (1 - 0.65 * speedFrac)
		steerVis += (steerTarget - steerVis) * (1 - math.exp(-12 * dt))
		local compF, hitF = physics:probe(1)
		local compR, hitR = physics:probe(2)
		-- wheel travel shown on the forks / swingarm, lightly smoothed
		local smooth = 1 - math.exp(-30 * dt)
		offF += (math.clamp(compF - travel * 0.5, -travel * 0.5, travel * 0.8) - offF) * smooth
		offR += (math.clamp(compR - travel * 0.5, -travel * 0.5, travel * 0.8) - offR) * smooth
		steerMotor.Transform = CFrame.Angles(0, -steerVis, 0)
		frontHubMotor.Transform = CFrame.new(0, offF, 0) * CFrame.Angles(-spinF, 0, 0)
		swingMotor.Transform = CFrame.Angles(-math.asin(math.clamp(offR / armLen, -0.5, 0.5)), 0, 0)
		rearHubMotor.Transform = CFrame.Angles(-spinR, 0, 0)

		-- sounds and brake light
		local braking = char ~= nil and throttle < -0.1 and vF > 1
		for _, l in ipairs(brakeLights) do
			l.Enabled = braking
		end
		if engineSound then
			local level = math.max(speedFrac, math.abs(throttle) * 0.6)
			engineSound.PlaybackSpeed = 0.6 + 1.1 * speedFrac + 0.15 * math.max(throttle, 0)
			engineSound.Volume = if char then engineVol * (0.35 + 0.65 * level) else 0
			if char and not engineSound.IsPlaying then
				engineSound:Play()
			end
		end
		if windSound then
			windSound.Volume = windVol * speedFrac
			if speedFrac > 0.05 and not windSound.IsPlaying then
				windSound:Play()
			end
		end

		-- rider pose
		if char ~= riderChar then
			if riderJoints then
				Pose.clear(riderJoints)
				riderJoints.mem = nil
			end
			if tookOver and riderChar then
				Pose.release(riderChar)
			end
			riderChar = char
			riderJoints = if char then Pose.joints(char) else nil
			tookOver = riderJoints ~= nil and char == player.Character -- R6 only; R15 keeps its sit animation
			if tookOver then
				Pose.takeOver(char)
			end
		end
		if riderJoints and char and riderJoints.hrp then
			Pose.silence(char)
			poseBounce += ((offF + offR) * 0.5 - poseBounce) * (1 - math.exp(-8 * dt))
			-- wheelie = nose higher than the ground slope under the wheels
			local pitch = math.asin(math.clamp(chassis.CFrame.LookVector.Y, -1, 1))
			local slope = 0
			if hitF and hitR then
				local d = hitF.Position - hitR.Position
				slope = math.asin(math.clamp(d.Y / math.max(d.Magnitude, 0.01), -1, 1))
			end
			local wheelieAngle = if hitR and compF <= 0 then math.max(pitch - slope, 0.2) else math.max(pitch - slope, 0)
			local steerCF = steerPivot.CFrame
			local chassisCF = chassis.CFrame
			Pose.solve(riderJoints, riderJoints.hrp.CFrame, chassisCF, {
				gripL = steerCF * gripL,
				gripR = steerCF * gripR,
				pegL = chassisCF * pegL,
				pegR = chassisCF * pegR,
			}, Config.Pose, {
				throttle = throttle,
				steer = steer,
				speed = vF,
				maxSpeed = Config.MaxSpeed,
				wheelie = if wheelieAngle > 0.12 then wheelieAngle else 0,
				bounce = -poseBounce,
				dt = dt,
			})
		end
	end)
end
-- @end

runBike(kit.Parent :: Model)
]]></ProtectedString><token name="RunContext">2</token><bool name="Disabled">false</bool></Properties></Item>
</Item>
